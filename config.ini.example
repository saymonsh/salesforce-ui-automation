[Auth]
USERNAME = your_username_here
PASSWORD = your_password_here
SECRET_KEY = your_secret_key_here

[Salesforce]
# URL to the Salesforce service schedule action
URL = https://your-salesforce-instance.lightning.force.com/lightning/action/quick/...
# Type of operation (e.g., 2)
TYPE = 2

[Activity]
DESCRIPTION = Activity Description
NUMBER = 30

# Note: there is no input-file path here. Data is entered in the in-app grid;
# an existing Excel file can be imported into the grid from inside the app.

[Logging]
# Verbose debug channel: when true, the activity feed/console show DEBUG-level
# detail (selectors clicked, Aura payloads/responses, step timings). The
# high-level Hebrew status field is unaffected either way.
DEBUG = false
